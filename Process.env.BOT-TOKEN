EMAIL_PASSWORD=mnnmmnnm9090EMAIL_USER=amirrza7030@gmail.com.const nodemailer = require('nodemailer');
const express = require('express');
require('dotenv').config(); // برای استفاده از متغیرهای محیطی

const app = express();
app.use(express.json());

app.post('/send-email', async (req, res) => {
  const { fileUrl, fileName, to } = req.body;

  const transporter = nodemailer.createTransport({
    service: 'gmail',
    auth: {
      user: process.env.EMAIL_USER,      // ایمیل از .env
      pass: process.env.EMAIL_PASSWORD   // رمز از .env
    }
  });

  const mailOptions = {
    from: 'ربات تلگرام',
    to,
    subject: '📎 فایل جدید از ربات',
    html: `<p>فایل جدید دریافت شد: ${fileName}</p><a href="${fileUrl}">دانلود فایل</a>`
  };

  try {
    await transporter.sendMail(mailOptions);
    res.send('✅ ایمیل ارسال شد');
  } catch (err) {
    console.error('❌ خطا در ارسال ایمیل:', err);
    res.status(500).send('خطا در ارسال ایمیل');
  }
});

app.listen(3000, () => console.log('📡 Email API running on port 3000'));
